{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/medical-journal-matcher/output-schema-1.0.0.json",
  "title": "Medical Journal Matcher Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "manuscript_profile",
    "constraints",
    "recommendations",
    "unverified_candidates",
    "excluded_candidates",
    "submission_readiness",
    "sources",
    "disclaimers"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "run": { "$ref": "#/$defs/run" },
    "manuscript_profile": { "$ref": "#/$defs/manuscriptProfile" },
    "constraints": { "$ref": "#/$defs/constraints" },
    "recommendations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sprint", "priority", "relatively_safe"],
      "properties": {
        "sprint": { "type": "array", "items": { "$ref": "#/$defs/recommendation" } },
        "priority": { "type": "array", "items": { "$ref": "#/$defs/recommendation" } },
        "relatively_safe": { "type": "array", "items": { "$ref": "#/$defs/recommendation" } }
      }
    },
    "unverified_candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "excluded_candidates": { "type": "array", "items": { "$ref": "#/$defs/excludedCandidate" } },
    "submission_readiness": {
      "oneOf": [
        { "type": "null" },
        { "type": "array", "items": { "$ref": "#/$defs/readinessFinding" } }
      ]
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/sourceFact" } },
    "disclaimers": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "generated_at", "jcr_data_mode", "privacy_mode", "consent_record", "scoring_version", "evidence_window", "source_health", "errors"],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "generated_at": { "type": "string", "format": "date-time" },
        "jcr_data_mode": { "enum": ["LICENSED_JCR", "USER_JCR_IMPORT", "PUBLIC"] },
        "privacy_mode": { "enum": ["LOCAL_PARSE_ONLY", "MODEL_ASSISTED_WITH_CONSENT", "OFFLINE_ONLY"] },
        "consent_record": { "type": ["object", "null"] },
        "scoring_version": { "const": "0.1.0" },
        "evidence_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" }
          }
        },
        "source_health": { "type": "object" },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/error" } }
      }
    },
    "manuscriptProfile": {
      "type": "object",
      "additionalProperties": true,
      "required": ["input_sufficiency", "primary_domain", "specialties", "submission_format", "study_designs", "reporting_guidelines", "methods", "population_or_object", "profile_confidence"],
      "properties": {
        "input_sufficiency": { "type": "string" },
        "primary_domain": { "type": "string" },
        "specialties": { "type": "array", "items": { "type": "string" } },
        "submission_format": { "type": ["string", "null"] },
        "study_designs": { "type": "array", "items": { "type": "string" } },
        "reporting_guidelines": { "type": "array", "items": { "type": "string" } },
        "methods": { "type": "array", "items": { "type": "string" } },
        "population_or_object": { "type": "array", "items": { "type": "string" } },
        "profile_confidence": { "type": "string" }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "required": ["required_wos_indexes", "target_jcr_quartiles", "target_jcr_categories", "jcr_category_match_policy", "oa_requirement", "apc_budget_mode", "publication_speed", "publisher_preferences", "tier_counts", "privacy_mode"],
      "properties": {
        "required_wos_indexes": { "type": "array", "items": { "type": "string" } },
        "target_jcr_quartiles": { "type": "array", "items": { "type": "string" } },
        "target_jcr_categories": { "type": "array", "items": { "type": "string" } },
        "jcr_category_match_policy": { "enum": ["ANY", "ALL"] },
        "oa_requirement": { "enum": ["REQUIRED_FULL_OA", "NO_REQUIREMENT"] },
        "apc_budget_mode": { "enum": ["HARD", "SOFT", "OFF"] },
        "publication_speed": { "type": "object" },
        "publisher_preferences": { "type": "array", "items": { "type": "string" } },
        "tier_counts": { "type": "object" },
        "privacy_mode": { "enum": ["LOCAL_PARSE_ONLY", "MODEL_ASSISTED_WITH_CONSENT", "OFFLINE_ONLY"] }
      }
    },
    "journal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journal_id", "journal_title_original", "publisher_original", "issn_l", "pissn", "eissn", "official_urls", "source_fact_ids"],
      "properties": {
        "journal_id": { "type": "string", "minLength": 1 },
        "journal_title_original": { "type": "string", "minLength": 1 },
        "publisher_original": { "$ref": "#/$defs/nullableString" },
        "issn_l": { "$ref": "#/$defs/nullableString" },
        "pissn": { "$ref": "#/$defs/nullableString" },
        "eissn": { "$ref": "#/$defs/nullableString" },
        "official_urls": { "type": "object" },
        "source_fact_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_key", "status", "reason_zh", "evidence_ref_ids"],
      "properties": {
        "gate_key": { "type": "string" },
        "status": { "enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_APPLICABLE"] },
        "reason_zh": { "type": "string" },
        "evidence_ref_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scoreDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension_key", "weight", "raw_score", "weighted_points", "status", "evidence_ref_ids", "explanation_zh"],
      "properties": {
        "dimension_key": { "type": "string" },
        "weight": { "type": "number", "minimum": 0 },
        "raw_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "weighted_points": { "type": ["number", "null"], "minimum": 0 },
        "status": { "enum": ["ASSESSED", "UNVERIFIED", "NOT_APPLICABLE"] },
        "evidence_ref_ids": { "type": "array", "items": { "type": "string" } },
        "explanation_zh": { "type": "string" }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["final_match_score", "score_coverage", "scoring_version", "dimensions"],
      "properties": {
        "final_match_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "score_coverage": { "type": "number", "minimum": 0, "maximum": 1 },
        "scoring_version": { "const": "0.1.0" },
        "dimensions": { "type": "array", "items": { "$ref": "#/$defs/scoreDimension" } }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons_zh", "input_sufficiency", "evidence_sufficiency", "provenance_completeness", "signal_agreement", "stability", "freshness"],
      "properties": {
        "level": { "enum": ["HIGH", "MEDIUM", "LOW"] },
        "reasons_zh": { "type": "array", "items": { "type": "string" } },
        "input_sufficiency": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence_sufficiency": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance_completeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "signal_agreement": { "type": "number", "minimum": 0, "maximum": 1 },
        "stability": { "type": "number", "minimum": 0, "maximum": 1 },
        "freshness": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "similarArticle": {
      "type": "object",
      "additionalProperties": true,
      "required": ["title_original", "publication_date", "date_type", "journal_title_original", "article_type_original", "doi", "source_ids", "integrity_status", "match_reasons_zh"],
      "properties": {
        "title_original": { "type": "string" },
        "publication_date": { "type": "string", "format": "date" },
        "date_type": { "type": "string" },
        "journal_title_original": { "type": "string" },
        "article_type_original": { "$ref": "#/$defs/nullableString" },
        "doi": { "type": "string", "pattern": "^10\\.\\d{4,9}/\\S+$" },
        "source_ids": { "type": "array", "items": { "type": "string" } },
        "integrity_status": { "enum": ["CLEAR", "CORRECTED", "EXPRESSION_OF_CONCERN", "RETRACTED", "UNVERIFIED"] },
        "match_reasons_zh": { "type": "array", "items": { "type": "string" } }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["journal", "gates", "score", "confidence"],
      "properties": {
        "journal": { "$ref": "#/$defs/journal" },
        "gates": { "type": "array", "items": { "$ref": "#/$defs/gate" } },
        "score": { "$ref": "#/$defs/score" },
        "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "recommendation": {
      "allOf": [
        { "$ref": "#/$defs/candidate" },
        {
          "type": "object",
          "required": ["strategy_tier", "tier_rationale_zh", "similar_articles", "strengths_zh", "mismatches_zh", "manual_checks_zh"],
          "properties": {
            "strategy_tier": { "enum": ["SPRINT", "PRIORITY", "RELATIVELY_SAFE"] },
            "tier_rationale_zh": { "type": "string" },
            "similar_articles": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "$ref": "#/$defs/similarArticle" } },
            "strengths_zh": { "type": "array", "items": { "type": "string" } },
            "mismatches_zh": { "type": "array", "items": { "type": "string" } },
            "manual_checks_zh": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    },
    "excludedCandidate": {
      "allOf": [
        { "$ref": "#/$defs/candidate" },
        {
          "type": "object",
          "anyOf": [{ "required": ["failed_gate"] }, { "required": ["exclusion_reason_zh"] }],
          "properties": {
            "failed_gate": { "type": "string" },
            "exclusion_reason_zh": { "type": "string" }
          }
        }
      ]
    },
    "sourceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_fact_id", "field", "value", "status", "source_type", "source_url", "retrieved_at", "data_year", "conflict_notes_zh"],
      "properties": {
        "source_fact_id": { "type": "string" },
        "field": { "type": "string" },
        "value": {},
        "status": { "enum": ["VERIFIED", "PUBLIC_CLAIM", "USER_SUPPLIED", "USER_ASSERTED", "UNVERIFIED", "CONFLICT", "STALE"] },
        "source_type": { "type": "string" },
        "source_url": { "$ref": "#/$defs/nullableString" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "data_year": { "type": ["integer", "null"] },
        "conflict_notes_zh": { "$ref": "#/$defs/nullableString" }
      }
    },
    "readinessFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "layer", "category", "severity", "status", "evidence_location", "observed_value", "expected_value", "source_rule_id", "suggested_action_zh", "limitation_zh"],
      "properties": {
        "check_id": { "type": "string" },
        "layer": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string" },
        "status": { "type": "string" },
        "evidence_location": { "$ref": "#/$defs/nullableString" },
        "observed_value": {},
        "expected_value": {},
        "source_rule_id": { "type": "string" },
        "suggested_action_zh": { "$ref": "#/$defs/nullableString" },
        "limitation_zh": { "$ref": "#/$defs/nullableString" }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_code", "stage", "source", "retryable", "impact_zh", "occurred_at"],
      "properties": {
        "error_code": { "type": "string" },
        "stage": { "type": "string" },
        "source": { "$ref": "#/$defs/nullableString" },
        "retryable": { "type": "boolean" },
        "impact_zh": { "type": "string" },
        "occurred_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
